{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/story/:path*",
      "destination": "/visit/",
      "permanent": false
    },
    {
      "source": "/experience/:path*",
      "destination": "/menu/",
      "permanent": false
    },
    {
      "source": "/journal/:path*",
      "destination": "/menu/",
      "permanent": false
    }
  ]
}
